
# ==========================================
# SpendWise - Full-Stack Project .gitignore
# ==========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python

# ---------- Python virtual environments ----------
venv/
.venv/
env/
ENV/
.virtualenv/

# ---------- Python packaging ----------
build/
dist/
downloads/
.eggs/
*.egg-info/
wheels/
pip-wheel-metadata/
share/python-wheels/

# ---------- Environment variables and secrets ----------
.env
.env.*
!.env.example
!.env.*.example

# ---------- FastAPI / Uvicorn ----------
uvicorn.log
*.log

# ---------- Testing and coverage ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
test-results/

# ---------- Type checking and linting ----------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- React / Node.js ----------
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.eslintcache

# ---------- Vite / frontend build ----------
dist/
build/
.vite/

# ---------- Frontend environment variables ----------
.env.local
.env.development.local
.env.test.local
.env.production.local

# ---------- PostgreSQL local database data ----------
pgdata/
postgres-data/
postgresql-data/
database-data/

# ---------- Database backups and dumps ----------
database-backups/
db-backups/
backups/
*.dump
*.backup
*.pgdump
*.sql.gz
*.bak

# ---------- Local SQLite databases ----------
*.sqlite
*.sqlite3
*.db

# NOTE:
# Keep safe SQL schema/setup scripts and Alembic migrations.
# Do not add *.sql here unless you intend to ignore all SQL scripts.

# ---------- IDEs and editors ----------
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- Operating system files ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100/
.Trashes/
Thumbs.db
Desktop.ini

# ---------- Temporary files ----------
*.tmp
*.temp
*.orig
*.rej

# ---------- Local uploads and generated files ----------
uploads/
media/
tmp/
temp/

# ---------- Documentation build output ----------
site/
docs/_build/

# ---------- Deployment secrets ----------
*.pem
*.key
*.p12
*.pfx

# ---------- Local tool state ----------
.python-version.local
.python_history
